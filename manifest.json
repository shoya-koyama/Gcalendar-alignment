{
  "manifest_version": 3,
  "name": "Google Calendar Tag Helper",
  "description": "Googleカレンダーの予定作成時にカスタムタグを追加できる拡張機能",
  "version": "1.0",
  "permissions": [
    "tabs",
    "storage",
    "activeTab",
    "scripting",
    "identity",
    "identity.email"
  ],
  "host_permissions": [
    "https://calendar.google.com/*"
  ],
  "icons": {
    "16": "icons/icon1.png"
  },
  "content_scripts": [
    {
      "js": [
        "const.js",
        "content_script.js"
      ],
      "matches": [
        "https://calendar.google.com/calendar/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
